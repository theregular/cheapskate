SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Expo reads EXPO_PUBLIC_* values into the mobile app bundle.
# For a physical phone testing local Supabase, use your computer's LAN IP,
# not localhost or 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://<computer-lan-ip>:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-from-npx-supabase-status>
