{
  "name": "cheapskate",
  "private": true,
  "packageManager": "npm@11.14.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace apps/mobile run start",
    "mobile:start": "npm --workspace apps/mobile run start",
    "mobile:android": "npm --workspace apps/mobile run android",
    "mobile:ios": "npm --workspace apps/mobile run ios",
    "mobile:iphone": "npm --workspace apps/mobile run iphone",
    "mobile:web": "npm --workspace apps/mobile run web",
    "mobile:reset-project": "npm --workspace apps/mobile run reset-project",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:pull": "npx supabase db pull",
    "db:types:local": "npm --workspace @cheapskate/database run db:types:local",
    "db:types:remote": "npm --workspace @cheapskate/database run db:types:remote"
  },
  "dependencies": {
    "expo": "~55.0.24",
    "expo-dev-client": "~55.0.34",
    "react": "19.2.0",
    "react-native": "0.83.6"
  },
  "version": "1.0.0",
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "supabase": "^2.102.0"
  }
}
